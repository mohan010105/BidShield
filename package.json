{
  "name": "bidshield-workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,green.bold\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix artifacts/api-server run dev",
    "dev:web": "npm --prefix artifacts/bidshield run dev",
    "build": "npm run build:libs && npm run build:api && npm run build:web",
    "build:libs": "tsc --build",
    "build:api": "npm --prefix artifacts/api-server run build",
    "build:web": "npm --prefix artifacts/bidshield run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build && npm --prefix artifacts/api-server run typecheck && npm --prefix artifacts/bidshield run typecheck",
    "test": "npm --prefix artifacts/api-server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
