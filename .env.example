# BidShield Local Development Environment Variables

# Node environment
NODE_ENV=development

# Backend API server port
PORT=5000

# Frontend Vite dev server port
VITE_PORT=5173

# Frontend API base URL (Vite dev proxy forwards /api to this URL)
VITE_API_URL=http://localhost:5000

# PostgreSQL Database URL
# Example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Entity Resolution Service Key (Phase 2 & Data Ingestion Entity Resolution)
ENTITY_RESOLUTION_SERVICE_KEY=your_entity_resolution_service_key_here
VITE_ENTITY_RESOLUTION_KEY=your_entity_resolution_service_key_here

# Analytics API Key (Phases 3 - 6 Screening & Analytics Engine)
ANALYTICS_API_KEY=your_analytics_api_key_here
VITE_ANALYTICS_API_KEY=your_analytics_api_key_here

# Phase 9 AI Assistant Integration (Server-side only)
AI_PROVIDER=mock
AI_MODEL=mock-grounded-v1
AI_API_KEY=
AI_API_ENDPOINT=

# Phase 15+ OpenAI Integration (Server-side only — NEVER expose to frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Production — restrict CORS origin to your frontend URL
# FRONTEND_URL=https://your-domain.com

